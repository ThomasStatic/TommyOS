<?xml version="1.0" encoding="utf-8"?>
<!-- ESPN fantasy ticker overlay. No launcher entry; driven from scripts/sports.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fire OS 8 has no UI for this; it is granted over ADB (appops), and the grant only sticks
         when the APK declares it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ESPN's fantasy API only (lm-api-reads.fantasy.espn.com). Lumen itself stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false">

        <!-- Exported for `adb shell am start-foreground-service`; DUMP (held by the shell, not by apps)
             keeps other apps from showing, hiding or refreshing it. A Lumen toggle will need a
             signature permission here instead. -->
        <service
            android:name=".TickerService"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Credentials arrive only from `adb shell`: DUMP is held by the shell, not by apps. -->
        <receiver
            android:name=".AuthReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
