<?xml version="1.0" encoding="utf-8"?>
<!-- ESPN fantasy ticker overlay. No launcher entry; driven from Lumen's settings, the phone controller or scripts/sports.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets Lumen switch and configure the ticker. Signature level: only apps signed with Lumen's key
         get it. Lumen declares the same permission, so either app may be installed first. -->
    <permission
        android:name="app.lumen.sports.permission.CONTROL"
        android:protectionLevel="signature" />

    <!-- Fire OS 8 has no UI for this; it is granted over ADB (appops), and the grant only sticks
         when the APK declares it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Its own control permission: needed to tell Lumen (same key) when to report app changes for auto mode. -->
    <uses-permission android:name="app.lumen.sports.permission.CONTROL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ESPN's fantasy API only (lm-api-reads.fantasy.espn.com). Lumen itself stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To retry as soon as the network returns after failed fetches (a normal, install-time permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Restarts the phone listener after a reboot, only if phone control is on (the ticker stays off). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lumen, for the auto-mode broadcast to its Home button service. -->
    <queries>
        <package android:name="app.lumen.home" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false">

        <!-- Started only from inside this app (ControlProvider, the phone controller). -->
        <service
            android:name=".TickerService"
            android:exported="false" />

        <!-- Show / hide / settings / status for Lumen (the signature permission) and `adb shell` (DUMP,
             which apps can't hold). Opening the provider takes either permission; call() checks again. -->
        <provider
            android:name=".ControlProvider"
            android:authorities="app.lumen.sports.control"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="app.lumen.sports.permission.CONTROL" />

        <!-- The phone controller's LAN listener; started only from inside this app. -->
        <service
            android:name=".PhoneService"
            android:exported="false" />

        <!-- Not exported: boot and package-replaced broadcasts come from the system, which reaches it anyway. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Credentials arrive only from `adb shell`: DUMP is held by the shell, not by apps. A provider
             call, not a broadcast: the system's broadcast history would keep the cookie in plain text. -->
        <provider
            android:name=".AuthProvider"
            android:authorities="app.lumen.sports.auth"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
