<?xml version="1.0" encoding="utf-8"?>
<!-- Cinema theme. Same view ids as activity_home.xml so HomeActivity drives both.
     Text sizes follow the Type scale in Theme.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_cinema" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- Clock: large and quiet, with one line of secondary information -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="64dp"
            android:layout_marginTop="44dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:shadowColor="#66000000"
                android:shadowRadius="20"
                android:textColor="#FFF5F5F7"
                android:textSize="88sp" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:letterSpacing="0.02"
                android:shadowColor="#66000000"
                android:shadowRadius="12"
                android:textColor="#B3F5F5F7"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Bottom cluster: focused name, floating dock, secondary controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="44dp">

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="16"
                android:textColor="#FFF5F5F7"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="16dp"
                android:textColor="#B3F5F5F7"
                android:textSize="16sp"
                android:visibility="gone" />

            <app.lumen.home.FrostedPanel
                android:id="@+id/frosted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp">

                <HorizontalScrollView
                    android:id="@+id/dockScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="11dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dockRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </app.lumen.home.FrostedPanel>

            <LinearLayout
                android:id="@+id/systemRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <!-- All Apps: full-screen near-black sheet opened from the Apps control -->
    <FrameLayout
        android:id="@+id/appsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF050506"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="32dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="64dp">

                <TextView
                    android:id="@+id/appsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="64dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/section_apps_title"
                    android:textColor="#FFF5F5F7"
                    android:textSize="34sp" />

                <LinearLayout
                    android:id="@+id/appsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="64dp"
                    android:paddingTop="32dp"
                    android:paddingEnd="64dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
