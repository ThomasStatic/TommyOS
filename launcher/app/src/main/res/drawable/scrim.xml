<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the top (clock legibility) and bottom (rows legibility) over any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#14000000"
                android:centerY="0.3"
                android:endColor="#00000000"
                android:startColor="#A6000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerColor="#73000000"
                android:centerY="0.4"
                android:endColor="#00000000"
                android:startColor="#E6000000" />
        </shape>
    </item>
</layer-list>
