<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 leanback banner shown in Fire TV's own app list. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size android:width="320dp" android:height="180dp" />
            <gradient
                android:angle="315"
                android:endColor="#FF2A1446"
                android:startColor="#FF0B1A3A" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_launcher"
        android:gravity="center" />
</layer-list>
