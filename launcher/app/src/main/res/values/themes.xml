<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lumen" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Cinema: stronger shadow alphas so white shadow colours read as a soft focus glow
         and the floating dock casts a gentle shadow. -->
    <style name="Theme.Lumen.Cinema">
        <item name="android:ambientShadowAlpha">0.32</item>
        <item name="android:spotShadowAlpha">0.28</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">48dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#8CFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
